{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rcn-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // O site (React) é embutido no Worker pelo scripts/embed-assets.mjs (npm run build).
  "queues": {
    "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "rcn-analysis" }],
    "consumers": [{ "queue": "rcn-analysis", "max_batch_size": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PORTAL_URL": "https://rcn-portal.mastertime-im.workers.dev",
    "SUPABASE_URL": "https://fvsjwuyawyyvnzlqkemh.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_9MDZKX7rPcNE6nluiZ9mXg_CJVMmhxe",
    "EMAIL_FROM": "Portal RCN <portal@seudominio.com.br>"
  },
  "observability": { "enabled": true }
  // Segredos (painel da Cloudflare ou wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY
}
